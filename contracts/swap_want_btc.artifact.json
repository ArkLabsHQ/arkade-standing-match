  "source": {
    "entry": "swap_want_btc.ark",
    "files": {
      "swap_want_btc.ark": "pragma arkade ^0.1.0;\n\ncontract SwapWantBtc(\n  // 32-byte taproot program of the maker's script. fulfill pays it on outputs[payoutIndex].\n  pubkey makerWP,\n  // Sats. outputs[payoutIndex] must carry at least this much.\n  int    wantAmount,\n  // 32-byte x-only key of the trader who funds the swap.\n  pubkey user,\n  // Index of the output that pays the maker. Two offers in one transaction use different indexes.\n  int    payoutIndex\n) {\n  function fulfill() {\n    require(tx.outputs[payoutIndex].value >= wantAmount);\n    let recipient = tx.outputs[payoutIndex].script;\n    require(recipient.version == 1);\n    require(recipient.program == makerWP);\n  }\n\n  function cancel(signature userSig, signature serverSig) tapscript {\n    require(checkMultisig([user, server], [userSig, serverSig], 2));\n  }\n\n  function exit(signature userSig) tapscript {\n    require(older(serverExitDelay));\n    require(checkSig(userSig, user));\n  }\n}\n"
    }
  },
