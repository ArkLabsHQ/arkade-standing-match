  "source": {
    "entry": "swap_want_asset.ark",
    "files": {
      "swap_want_asset.ark": "pragma arkade ^0.1.0;\n\ncontract SwapWantAsset(\n  // 32-byte taproot program of the maker's script. fulfill pays it on outputs[payoutIndex].\n  pubkey  makerWP,\n  // Asset units. outputs[payoutIndex] must carry at least this much of the wanted asset.\n  int     wantAmount,\n  // The wanted asset's genesis txid, in internal byte order.\n  bytes32 wantAssetTxid,\n  // The wanted asset's group index.\n  int     wantAssetGroupIndex,\n  // 32-byte x-only key of the trader who funds the swap.\n  pubkey  user,\n  // Index of the output that pays the maker. Two offers in one transaction use different indexes.\n  int     payoutIndex\n) {\n  function fulfill() {\n    require(tx.outputs[payoutIndex].assets.lookup(wantAssetTxid, wantAssetGroupIndex) >= wantAmount);\n    let recipient = tx.outputs[payoutIndex].script;\n    require(recipient.version == 1);\n    require(recipient.program == makerWP);\n  }\n\n  function cancel(signature userSig, signature serverSig) tapscript {\n    require(checkMultisig([user, server], [userSig, serverSig], 2));\n  }\n\n  function exit(signature userSig) tapscript {\n    require(older(serverExitDelay));\n    require(checkSig(userSig, user));\n  }\n}\n"
    }
  },
